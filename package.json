{
  "name": "celahan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/unit/*.test.mts",
    "test:integration": "node --env-file=.env.local --env-file=.env.database.local tests/integration/accounts.mts",
    "db:migrate": "node --env-file=.env.local --env-file=.env.database.local scripts/migrate.mts",
    "db:prepare-test-role": "node --env-file=.env.local --env-file=.env.database.local scripts/prepare-test-role.mts",
    "account:admin": "node --env-file=.env.local --env-file=.env.database.local scripts/admin-account.mts",
    "mailbox": "node --env-file=.env.local scripts/mailbox.mts"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
