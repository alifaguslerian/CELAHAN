# Leave authentication disabled until isolated secrets and a test database exist.
CELAHAN_ISOLATED_AUTH=false
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=
# Runtime role: DML only, pooled Neon URL with sslmode=verify-full.
DATABASE_URL=
# Put this owner variable in a SEPARATE ignored .env.database.local file,
# not the application .env.local. Only manual migration/admin/test scripts load it.
DATABASE_MIGRATION_URL=
CELAHAN_TEST_EMAILS=user-a@example.invalid,user-b@example.invalid,admin@example.invalid,disabled@example.invalid
CELAHAN_MAILBOX_URL=http://127.0.0.1:3102/messages
CELAHAN_MAILBOX_SECRET=
