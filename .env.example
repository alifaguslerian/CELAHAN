# === OPTION A: Local isolated development (.env.local) ===
# Leave both flags false until secrets and the Neon database exist.
CELAHAN_ISOLATED_AUTH=false
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=
# Runtime role: DML only, pooled Neon URL with sslmode=verify-full.
DATABASE_URL=
# Put this owner variable in a SEPARATE ignored .env.database.local file,
# not the application .env.local. Only manual migration/admin/test scripts load it.
DATABASE_MIGRATION_URL=
CELAHAN_TEST_EMAILS=user-a@example.invalid,user-b@example.invalid,admin@example.invalid,disabled@example.invalid
CELAHAN_MAILBOX_URL=http://127.0.0.1:3102/messages
CELAHAN_MAILBOX_SECRET=

# Optional OAuth providers (required for Google/GitHub sign-in locally, and mandatory for hosted mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === OPTION B: Hosted HTTPS deployment on Vercel ===
# Set these in Vercel Project Settings -> Environment Variables (do NOT set CELAHAN_ISOLATED_AUTH):
# CELAHAN_HOSTED_AUTH=true
# BETTER_AUTH_URL=https://your-project.vercel.app
# BETTER_AUTH_SECRET=<32+ char random base64url string>
# DATABASE_URL=<pooled celahan_app Neon URL with sslmode=verify-full>
# GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# GITHUB_CLIENT_ID=<your-github-client-id>
# GITHUB_CLIENT_SECRET=<your-github-client-secret>
